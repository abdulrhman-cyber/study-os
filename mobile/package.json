{
  "name": "study-os-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android (Capacitor) wrapper for Study OS",
  "scripts": {
    "sync:web": "powershell -NoProfile -ExecutionPolicy Bypass -File sync-web.ps1",
    "add:android": "cap add android",
    "sync": "npm run sync:web && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
